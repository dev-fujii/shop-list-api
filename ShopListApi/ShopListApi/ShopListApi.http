@ShopListApi_HostAddress = http://localhost:5247

# 32は設定変更専用
# 「無いID」の999は、実際に存在しないことを確認して使う

# ---------- 分類 ----------

### 1. 分類の一覧
GET {{ShopListApi_HostAddress}}/categories
Accept: application/json

### 2. 分類を作る（201 と Location が返る）
# @name food
POST {{ShopListApi_HostAddress}}/categories
Content-Type: application/json

{
  "name": "食費"
}

### 3. 同じ名前でもう一度作る（409 category.duplicate_name）
POST {{ShopListApi_HostAddress}}/categories
Content-Type: application/json

{
  "name": "食費"
}

### 4. 空白だけの名前（400）
POST {{ShopListApi_HostAddress}}/categories
Content-Type: application/json

{
  "name": "   "
}

### 5. 21文字の名前（400）
POST {{ShopListApi_HostAddress}}/categories
Content-Type: application/json

{
  "name": "あいうえおかきくけこさしすせそたちつてとな"
}

### 6. 分類を1件（200。2 で作った分類）
GET {{ShopListApi_HostAddress}}/categories/{{food.response.body.$.id}}
Accept: application/json

### 7. 無い分類（404 category.not_found）
GET {{ShopListApi_HostAddress}}/categories/999
Accept: application/json

### 8. もう1つ分類を作る（11 で使う）
# @name daily
POST {{ShopListApi_HostAddress}}/categories
Content-Type: application/json

{
  "name": "日用品"
}

### 9. 分類の名前を変える（204。6 をもう一度送ると名前が変わっている）
PUT {{ShopListApi_HostAddress}}/categories/{{food.response.body.$.id}}
Content-Type: application/json

{
  "name": "株"
}

### 10. 無い分類の名前を変える（404 category.not_found）
PUT {{ShopListApi_HostAddress}}/categories/999
Content-Type: application/json

{
  "name": "株"
}

### 11. ほかの分類と同じ名前に変える（409 category.duplicate_name。9 で付けた名前）
PUT {{ShopListApi_HostAddress}}/categories/{{daily.response.body.$.id}}
Content-Type: application/json

{
  "name": "株"
}

### 12. 分類を消す（204）
DELETE {{ShopListApi_HostAddress}}/categories/{{food.response.body.$.id}}

### 13. 無い分類を消す（404 category.not_found）
DELETE {{ShopListApi_HostAddress}}/categories/999

### 14. 後片付け: 8 で作った分類を消す（204）
DELETE {{ShopListApi_HostAddress}}/categories/{{daily.response.body.$.id}}

### 15. 無い URL（404。本文は Problem Details の形）
GET {{ShopListApi_HostAddress}}/nothing
Accept: application/json

# ---------- 取引の登録・入力チェック ----------
# POSTを送るたびに取引が増える。不要な取引は49のように削除する

### 16. 取引を登録する・全部の項目あり（201 と Location が返る）
# @name lawson
POST {{ShopListApi_HostAddress}}/transactions
Content-Type: application/json

{
  "amount": 1200,
  "merchant": "ローソン",
  "date": "2026-10-17",
  "type": "expense",
  "source": "auto"
}

### 17. date と type を省く（201。date は日本時間の今日、type は expense になる）
POST {{ShopListApi_HostAddress}}/transactions
Content-Type: application/json

{
  "amount": 500,
  "merchant": "自動販売機",
  "source": "manual"
}

### 18. source を省く（400。errors に Source）
POST {{ShopListApi_HostAddress}}/transactions
Content-Type: application/json

{
  "amount": 1200,
  "merchant": "ローソン"
}

### 19. 金額が 0（400。errors に Amount）
POST {{ShopListApi_HostAddress}}/transactions
Content-Type: application/json

{
  "amount": 0,
  "merchant": "ローソン",
  "source": "auto"
}

### 20. 金額が 1,000万円（400。9,999,999 までなので）
POST {{ShopListApi_HostAddress}}/transactions
Content-Type: application/json

{
  "amount": 10000000,
  "merchant": "ローソン",
  "source": "auto"
}

### 21. 51文字の店名（400）
POST {{ShopListApi_HostAddress}}/transactions
Content-Type: application/json

{
  "amount": 1200,
  "merchant": "あいうえおかきくけこあいうえおかきくけこあいうえおかきくけこあいうえおかきくけこあいうえおかきくけこさ",
  "source": "auto"
}

### 22. source を数字で送る（400。名前の文字列だけ受け付ける）
POST {{ShopListApi_HostAddress}}/transactions
Content-Type: application/json

{
  "amount": 1200,
  "merchant": "ローソン",
  "source": 0
}

# ---------- 取引の1件取得 ----------

### 23. 取引を1件（200。16 で登録した取引）
GET {{ShopListApi_HostAddress}}/transactions/{{lawson.response.body.$.id}}
Accept: application/json

### 24. 無い取引（404 transaction.not_found）
GET {{ShopListApi_HostAddress}}/transactions/999
Accept: application/json

# ---------- 取引一覧・ページ分割 ----------
# 日付の新しい順、同じ日付は id の大きい順。17 の今日の取引が 16 より先
# totalCount はページ分割前の全件数。返ってきた items の件数とは別

### 25. ページ指定を省略する（200。page = 1、pageSize = 50）
GET {{ShopListApi_HostAddress}}/transactions
Accept: application/json

### 26. 1ページ目を1件取得（200。items が1件）
GET {{ShopListApi_HostAddress}}/transactions?page=1&pageSize=1
Accept: application/json

### 27. 2ページ目を1件取得（200。26 と id が異なり、totalCount は同じ）
GET {{ShopListApi_HostAddress}}/transactions?page=2&pageSize=1
Accept: application/json

### 28. ページ番号が0（400。errors に page）
GET {{ShopListApi_HostAddress}}/transactions?page=0
Accept: application/json

### 29. 1ページの件数が上限を超える（400。errors に pageSize）
GET {{ShopListApi_HostAddress}}/transactions?pageSize=101
Accept: application/json

### 30. 1ページの件数が0（400。errors に pageSize）
GET {{ShopListApi_HostAddress}}/transactions?pageSize=0
Accept: application/json

### 31. 最後のページより後ろを指定する（200。items は空、totalCount は全件数のまま）
GET {{ShopListApi_HostAddress}}/transactions?page=999
Accept: application/json

# ---------- 設定ファイルからの読み込み確認（必要なときだけ） ----------
# 1. appsettings.json の Pagination を DefaultPageSize = 1、MaxPageSize = 2 に変え、API を再起動する
# 2. 25 を送り、pageSize = 1 で items が1件になることを確認する
# 3. 32 を送り、400 と「pageSize は1～2で指定してください。」が返ることを確認する
# 4. 設定を DefaultPageSize = 50、MaxPageSize = 100 に戻し、API を再起動する

### 32. 設定で変更した上限を超える（試験用の上限2なら400。通常の上限100なら200）
GET {{ShopListApi_HostAddress}}/transactions?pageSize=3
Accept: application/json

# ---------- 取引の更新・削除・絞り込み ----------
# 33・34で作る専用データだけを更新・削除する。既存のローソン・自動販売機は残す
# 33の分類名が重複したら前回のデータを確認する

### 33. 確認用の分類を作る（201）
# @name exerciseCategory
POST {{ShopListApi_HostAddress}}/categories
Content-Type: application/json

{
  "name": "確認用"
}

### 34. 確認用の取引を作る（201。source は manual）
# @name exerciseTransaction
POST {{ShopListApi_HostAddress}}/transactions
Content-Type: application/json

{
  "amount": 1000,
  "merchant": "確認用",
  "date": "2026-10-20",
  "type": "expense",
  "source": "manual"
}

### 35. 取引を更新する（204）
PUT {{ShopListApi_HostAddress}}/transactions/{{exerciseTransaction.response.body.$.id}}
Content-Type: application/json

{
  "amount": 1500,
  "merchant": "更新後",
  "date": "2026-10-21",
  "type": "income",
  "categoryId": {{exerciseCategory.response.body.$.id}}
}

### 36. 更新後の取引を取得する（200。35の内容が反映され、source は manual のまま）
# 41〜45のエラーのあとも再送し、35の値から変わっていないことを確認する
GET {{ShopListApi_HostAddress}}/transactions/{{exerciseTransaction.response.body.$.id}}
Accept: application/json

### 37. 分類で絞り込む（200。items と totalCount は、この分類の取引だけ）
GET {{ShopListApi_HostAddress}}/transactions?categoryId={{exerciseCategory.response.body.$.id}}&pageSize=1
Accept: application/json

### 38. 同じ開始日・終了日で絞る（200。10月21日の取引だけ）
GET {{ShopListApi_HostAddress}}/transactions?from=2026-10-21&to=2026-10-21
Accept: application/json

### 39. 開始日が終了日より後（400。errors に from）
GET {{ShopListApi_HostAddress}}/transactions?from=2026-10-22&to=2026-10-21
Accept: application/json

### 40. 存在しない日付（400。ASP.NET Core の入力チェック）
GET {{ShopListApi_HostAddress}}/transactions?from=2026-02-30
Accept: application/json

### 41. 無い分類に変更する（422 category.not_found。取引は変更されない）
# 分類ID 999 が存在しないことを確認してから送る
PUT {{ShopListApi_HostAddress}}/transactions/{{exerciseTransaction.response.body.$.id}}
Content-Type: application/json

{
  "amount": 9999,
  "merchant": "変更されないはず",
  "date": "2026-10-22",
  "type": "expense",
  "categoryId": 999
}

### 42. 金額0で更新する（400。取引は変更されない）
PUT {{ShopListApi_HostAddress}}/transactions/{{exerciseTransaction.response.body.$.id}}
Content-Type: application/json

{
  "amount": 0,
  "merchant": "変更されないはず",
  "date": "2026-10-22",
  "type": "expense",
  "categoryId": null
}

### 43. 日付を省いて更新する（400。errors に Date。取引は変更されない）
PUT {{ShopListApi_HostAddress}}/transactions/{{exerciseTransaction.response.body.$.id}}
Content-Type: application/json

{
  "amount": 9999,
  "merchant": "変更されないはず",
  "type": "expense",
  "categoryId": null
}

### 44. 種類を省いて更新する（400。errors に Type。取引は変更されない）
PUT {{ShopListApi_HostAddress}}/transactions/{{exerciseTransaction.response.body.$.id}}
Content-Type: application/json

{
  "amount": 9999,
  "merchant": "変更されないはず",
  "date": "2026-10-22",
  "categoryId": null
}

### 45. 無い取引を更新する（404 transaction.not_found）
PUT {{ShopListApi_HostAddress}}/transactions/999
Content-Type: application/json

{
  "amount": 1500,
  "merchant": "確認用",
  "date": "2026-10-21",
  "type": "income",
  "categoryId": null
}

### 46. 使用中の分類を削除する（409 category.in_use）
DELETE {{ShopListApi_HostAddress}}/categories/{{exerciseCategory.response.body.$.id}}
Accept: application/json

### 47. 取引を未分類に変更する（204。36を再送すると categoryId は null）
PUT {{ShopListApi_HostAddress}}/transactions/{{exerciseTransaction.response.body.$.id}}
Content-Type: application/json

{
  "amount": 1500,
  "merchant": "更新後",
  "date": "2026-10-21",
  "type": "income",
  "categoryId": null
}

### 48. 使われなくなった分類を削除する（204）
DELETE {{ShopListApi_HostAddress}}/categories/{{exerciseCategory.response.body.$.id}}
Accept: application/json

### 49. 取引を削除する（204）
DELETE {{ShopListApi_HostAddress}}/transactions/{{exerciseTransaction.response.body.$.id}}
Accept: application/json

### 50. 削除した取引を取得する（404 transaction.not_found）
GET {{ShopListApi_HostAddress}}/transactions/{{exerciseTransaction.response.body.$.id}}
Accept: application/json

### 51. 同じ取引をもう一度削除する（404 transaction.not_found）
DELETE {{ShopListApi_HostAddress}}/transactions/{{exerciseTransaction.response.body.$.id}}
Accept: application/json
