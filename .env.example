# compose.yaml が読む値の見本
# このファイルをコピーして .env を作り、値を書き換える（.env は git に入れない）

# DB のユーザー・パスワード・DB 名
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ここにパスワード
POSTGRES_DB=kakeibo

# DB の PC 側のポート
POSTGRES_PORT=5433

# API の仮の鍵（X-Api-Key ヘッダーで送る値）。openssl rand -hex 32 などで作る
API_KEY=ここに鍵

# ログインのトークンに署名する RSA の秘密鍵。PKCS#8 の形を Base64 にした1行の文字列
# Git Bash で次のように作る
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | grep -v -- '-----' | tr -d '\r\n'
JWT_PRIVATE_KEY=ここに秘密鍵

# API の PC 側のポート（省略すると 8080）
# API_PORT=8080
